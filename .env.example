# Copy this file to ".env" (which git ignores), fill in what you need, then run:  chmod 600 .env
# Real environment variables override this file. Everything is optional: with no .env the assistant runs fully on this Mac.

# --- Gemini (cloud) as the primary brain. Off by default. ---
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# If Gemini is out of quota, unreachable or too slow, switch to the local Ollama model automatically (and back later).
USE_LOCAL_FALLBACK=true

# --- The local model (Ollama). Empty means: use "ollama.model" from config.yaml. ---
LOCAL_MODEL_NAME=

# --- Safety: with SAFE_MODE=true every browser action asks you first. ---
SAFE_MODE=false

# --- Speech. STT_ENGINE: whisper (whisper.cpp, local) or macos (use macOS Dictation in the text box).
#     TTS_ENGINE: piper (local, default) or say (the Mac's voice). "google" is not built yet. ---
STT_ENGINE=whisper
TTS_ENGINE=piper
